فـيـه، و�إعـادة\nالأوراق �إلــى غــرفـــة الـمـ|شـورة مُـ}صـدرة الـحـكـم، لـتـفـ}صــل فــي طـلـب اال6سـتـ|شـكـال\nمن جــديـــد بـهـيــئــــة مــغــــايــــرة، وفـــقًــــا للإجــــراءات الـمــقــــررة قــــانــــونـــــــــًا.\nاملحكمـــة\nبعــــد االطالع على احلكم املطعون فيه وعلى 6سائر الأوراق، وبعد 6سماع التقرير\nالذي �أعده وتــاله القا9ضي املقرر، وبعد املداولة طبقًا للقانون.\nحيث �إن الطعن ا6ستوفى 6سائر �أو9ضاعه املقررة قانونا فهو مقبول 7شكال\nوحيث ينعـى الطاعـن (االدعاء الـعـام) عـلــى الـحـكــم الـمـطـعـون فـيـــه خمالفـة\nالقانون،  وال}صواب  فـي  تطبيقـه  وتـ�أويـلـه،  والق}صور  فـي  الـتــ{سبـــيـــب  حـيـنـمـا\nقـ~ضـى بوقف تـنـفـيـذ الـعـقـوبة ال}صادرة بحق الـمطعون 9ضده �إذ �إن ذلك يـ|شـكــل\nمــخـالـفـة 8صــارخـة لــحـجـيـــة الأحـكـام وتــجـــاوزًا مــن مــحـكـمـة اال6سـتـــ|شـكـال\n) من قــانـون الإجراءات الــجـزائـيـة 279( لواليــتـهــا بالـمـخـالــفـة لنــ}ص الـمـادة\nالـتــي تـنـ}ص عـلـى �أنـه: «�إذا 8صــدر حـكـم فـي مـو9ضـوع الدعـوى الـعـمـومـيـة، فـال\nيـجـوز �إعـادة نــظـرهـا �إال بالطـعـن فـي هـذا الـحـكـم بالـطـرق الـمـقـررة فـي هــذا\nالــقــانـــون...»،  كما �أن  اال6سـتـ|شـكـال  لـيـ{س  طــريـقـًا  مـن  الــطـــرق  الـمـحـددة\nقـانــونـــًا لإعـــادة الــنـظـر فـي الأحـكـام، فــهـو لــيـــ{س نــعــيـــــًا عــلـى الـحـكـم بــل\nهـو نـعــيٌ عـلـى الـتـنـفـيـذ ذاتـه، ويـجـب �أن يـكـون 6ســبــبـــه حــا8صـلاً بـعــد 8صــدور\nالـحـكـم، ومبــنـــيًا عـلــى وقـــائـــــع الحــقــــة عـلـــيــــه، فـي حـيــن �أن الأ6سـبـــاب التـي\nا6ســتــنــــد �إليـهـا حـكـم اال6سـتــ|شـكــال الـمـطـعـون فــيــــه فـيـمــا انتهى �إلــيــــه هـي فـي\nحـقـيـقـتـهـا �أ6سـبـابـًا مــو9ضـوعـيـة مـتـعـلـقـة بالظـــروف االجـتـمـاعــيــة والأ6سريــة\nللـمـطـعـون 9ضــده، وهـــي 6سابـــقــــة عـلـى 8صدور حـكـم اال6سـتـ|شـكــال الـمـطـعـون فـيـه،\n\n– 859 –\n وكــان بــ�إمـكـان الـمـطـعـون 9ضــده �إثـارتـهــا فــي �أي مــن مـراحــل الدعوى، وبالـتـالــي\nفـهـي ال تـعـد نــعـيـــًا عـلـى الـتـنـفــيــذ �إنـمـا نـعـي عــلـى الـحـكــم الـمـ{سـتـ|شـكــل فــيـه\nفـيـمـا قـ~ضــى به من تــقـديـر الـعـقـوبة الـمـحـكـوم بـهـا، الأمـــر الذي يـخـرج عن\nواليـة مـحـكـمـة اال6سـتـ|شـكـال، فـ~ضـلاً عن �أن اال6ســتــنــــاد �إلـــى نظرية الـ~ضـرورة\nمـ|شـروط ب�أن يـتـرتـــب عـلـى التـنـفـيـذ �إلـحـاق 9ضـرر جـ{سـيـم بالـمـحـكـوم عـلـيـه\nال ميكن تداركه ويـفـ~ضــي �إلـى تـهـديـده فـي حـيـاتــه �أو 6سالمـة جـ{سـمـه عـلـى\nنـحـو خـطـيــر وهـو مـا قـ}صـر الـحـكـم فـي الـتـدلـيـل عـلـيـه وا6ستظـهـاره، مما يعيب\nالـحـكم الـمطعون فـيـــه مبا ي{ستوجب نق~ضه، وتـ}صـحـيـحـه ب�إلغاء فقرة وقف تنفيذ\nالعقوبة.\n) 316( ) �إىل312( وحيث �إنـه مـن الـمـقـرَّر �أن الـمـ|شـرع ر6سم بـمـوجـب الـمـواد من\nمن  قانون  الإجراءات  الـجـزائـيـة،  الإجراءات  الـتـي  يـتـعـيـن  عـلـى  الـمـحـاكـم\nالـجـزائـيـة اتـبـاعــهــا للـفـ}صـــل فـي طـلـبـات اال6سـتـ|شـكـال فـي تـنـفـيـذ الأحـكـام\nالـجــزائـيــة،  فـــحــدد  طـريـق  رفع  هذه  الـطـلـبـات �إلـى  الـمـحـكـمـة  مـ}صـدرة\nالـحـكـم، وبـيــّن كـيـفـيـة عــقـد الـمـحـكــمـة الــجـلـ{سـة للـفـ}صـل فـيـــهـــا فـي غـرفــة\nالــمـ|شـورة،  كــمـا �أوجــب  عــلـــى  االدعاء  الــعــــام  تــكــلـيـف  الأطـراف  الـحـ~ضـور\nللـجـلـ{سـة  الـتــي  حددت  لـنـظـر  اال6سـتـ|شـكـــال،  و�أن  عـلـى  الـمـحـكـمـــة  قــبــل\nالــفــ}صـل فـــي اال6سـتـ|شـكـال الـمـعـرو9ض عـلـيـهـــا 6سـمـــاع الأطــــراف وذوي الـــ|ش�أن،\nو�أن للــمـحـكـمــة �أن تـجـري الـتـحـقـيـقــات الــتـــي تـــراهـــا الزمــــة للــفـ}صـل فـي\nاال6سـتــ|شــكـــال، و�أن للــمــ{ســتـ|شـكـــل �أن يــنــيــب عــنـــه وكـــيـــــلاً لـــتــقـديـم دفاعه\nدون �أن  يــخـل  ذلك  بـحـق  الـمـحـكـمــة  فـي �أن  ت�أمـــر  بــحـ~ضـور  الـمـ{ســتــ|شــكـــــل\n�أمـــامـــــهـــــا بـــ|شـــخـــــ}صـــــــه.\nولـمـَّا كــان ذلك، وكـــان الـبــيــــّن مـن ديــبـــــاجــــة الــحـكـم الـمـطـعـون فــيـه �أن\nغــرفــة الـمــ|شـــورة الــمــطــعـــون فـي حــكـمـها نـــظــــرت دعـوى طــلـــب اال6سـتـ|شـكـــال\nمــ�ؤلـــفــــة مـن ثــالثــــة قــ~ضـــاة بـدون حــ~ضـور عـ~ضـو االدعاء العام،  وقد خلت\n�أوراق الدعوى من وجود حم~ضر للجل{سة  ومما يفيد ب�أنها �أعــلـنـت طـــرفـــي الـنــــزاع\nلــحـ~ضــور الــجــلـــ{ســـة بـغـرفـة الـمـ|شـورة وهـمـا الـمـ{سـتـ|شـكـــل واالدعاء الــعــام\nلــ{ســمــــاع �أقـــوال طـــالـــب اال6ســتـــ|شــكــــال ور�أي االدعاء الـــعـــام فــي الــطـلـب،\nبــاعــتـبـار �أن  االدعاء  الـــعـــام  هو  الـخـ}صـم  الأ8صـيـل  الـمـخـتـ}صــم  فــي  طـــلــــب\nاال6ســتـــ|شــكـــال،  مِـمَّـا  يــُعـد  مــنـــهــا  مــخــالــفـــة  لـمـا �أوجـبـتـه  الـمـواد  6سالــفـة\n\n– 860 –\n ) من قانـــون الإجراءات الــجـزائــيـــة، و�أيــ~ضـًا313( الــذكـــر وبالأخــ}ص الـمـادة\n)  من  الــقـانون  ذاتــه  الــتــــي �أوجــبــــت  حــ~ضـــور �أحد 179    و178(  الـمــادتان\n�أعـــ~ضــاء االدعاء الـــعـــام بـــ{ســائـــر جــلـــ{ســـات الـمــحــاكــم الـجـزائــيــــة، و6ســمــاع\n�أقـوالـه، والــفــ}صـل فــي طـــلــبــاتــه، �إذ ال يـكــتـمـل قانونيًا تــ|شـكــيـــل هــيـــئــــة\nغــرفــــة الــمــ|شـــورة عــنـد نـــظـــرها طـــلـــب اال6ســتــ|شــكــــال �إال بــوجــــود هذا\nالـخـ}صـم الأ8صـــيــــل فــي الــجــلـــ{ســة الـمــعـــيـنـة لــنـظـــر اال6ســتـ|شـكـــال وتدويـــن\nما دار فــيــهـــا من قبل �أمـيــــن الـــ{سـر يف حم~ضر يت~ضمن �إىل جانب �إثبات ما دار\nفيها الهيئة والتاريخ، و�إذ 8صـــدر الـحـكـم الــمـطــعــون فــيـه بالـمـخــالـــفــة لــكــــل\nذلك  فـــ�إن  الإجــــراءات  تـــكــون  بــاطـــلـــة  بــطـــالنــــًا  مــطـــلـــقــــًا  لـــتــعـــلـــقــــه\nبـــ�إجـــــراءات �آمـــــرة  بـ|شـ�أن  تــ|شـكـيـل  الـــهـيــئـات،  وتــنـظـيــم  8صـدور  الأحــكـام\nالـــجــــزائـــيــــــــة مما يتعني معه نق~ض احلكم و�إعادته  لغرفة امل|شورة لتنظره بهيئة\nمغايرة  دون احلاجة للتطرق لأ6سباب النق~ض املو9ضوعية التي �أثارها االدعاء.\nفلهذه الأ6سباب:\nحكمت املحكمة بقــبــول الــطــعــن 7شـكـلاً ، وفـي املو9ضـوع بنق~ض الـحـكـم الـمـطـعـون\nفـيـه، و�إعـادة الأوراق �إلــى غــرفـــة الـمـ|شـورة مُـ}صـدرة الـحـكـم، لـتـفـ}صــل فــي طـلـب\nاال6سـتـ|شـكـال من جــديـــد بـهـيــئـــة مــغـايــرة، وفـقـًا للإجـراءات الـمــقــررة قانونًا.\n\n– 861 –\nم2020/8/20 جل{سة يوم الثالثاء\nبرئا6سة ف~ضيلة القا9ضي/ حممد بن عبداهلل احلجري، وع~ضوية كل من �أ8صحاب\nا