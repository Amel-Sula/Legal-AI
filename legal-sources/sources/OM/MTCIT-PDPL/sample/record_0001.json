ـيابرف نم 6 : قــــفاوـلما\nديعس� نب س�وباق\nناـــمـع ناطلـــس�\n- 3 -\n\n)929( ددعلا ةيمس�رلا ةديرلجا\nتامولعلما ةينقت مئارج ةحفاكم نوناق\nلوألا لس�فلا\nةماع ماكحأاو تافيرعت\n) 1 ( ةداـــلما\nاهنم لك نيرق ينبلما ىنعلما ةيتآلا تارابعلاو تاملكلل نوكي نوناقلا اذه ماكحأا قيبطت ىف\n: رخآا ىنعم ض�نلا قايس� ض�تقي لم ام\n: ةئيهلا - أا\n. تامولعلما ةينقت ةئيه\n: تامولعلما ةينقت - ب\nتانايبلا عيزوتو ةلجاعلم تلاس�تلاو تاينوتركلإلاو ةبس�وحلل ىملعلا مادختس�لا\n. ةفلتخلما اهغيس�ب تامولعلماو\n: تامولعلما ةينقت مئارج - ج\n. نوناقلا اذه ىف اهيلع ض�وس�نلما مئارلجا\n: ةينوتركلإلا تامولعلماو تانايبلا - د\nناك ايأا تامولعلما ةينقت لئاس�وب هلقنو هديلوتو هتلجاعمو هنيزخت نكيم ام لك\n. تاراس�إلاو زومرلاو تاوس�ألاو روس�لاو ةباتكلاك هلكس�\n: ةيموكلحا تامولعلماو تانايبلا - ـه\n. ةلودلل ىرادإلا زاهلجا تادحوب ةس�الخا ةينوتركلإلا تامولعلماو تانايبلا\n: تامولعلما ةينقت ةليس�و - و\nاـهنيزخت وأا ةـينوتركلإلا تاـمولعلماو تاـنايبلا ةـلجاعلم مدــختس�ي ىــنوتركلإا زاــهج\n. لاس�تلا ةزهجأاو لىآلا بس�الحا ةزهجأاك اهلابقتس�ا وأا اـهلاس�رإا وأا\n: ةيتامولعلما ةكبس�لا - ز\nتامولعلماو تانايبلا ىلع لوس�حلل تامولعلما ةينقتل ةليس�و نم ثركأا ينب طابترا\n. اهلدابتو ةينوتركلإلا\n: ىنوتركلإلا عقولما - ح\n. ددمح ناونع للاخ نم ةيتامولعلما ةكبس�لا ىلع ةينوتركلإلا تامولعلما ةحاتإا ناكم\n- 4 -\n\n)929( ددعلا ةيمس�رلا ةديرلجا\n: ىتامولعلما جمانبرلا - ط\nتامولعلما ةينقت لئاس�و مادختس�اب ذيفنتلل ةلباقلا رماوألاو تانايبلا نم ةعوممج\n. ةددمح ةمهم زانجإل ةدعمو\n: ىتامولعلما ماظنلا - ى\nتاـــــمولعلماو تاــــنايبلا ةرادإاو ةـــلجاعم ىــف مدـــختس�ت تاودأاو جـــــمارب ةـــــعوممج\n. ةينوتركلإلا\n: ةمدلخا دوزم - ك\nلس�اوتلل تامدلخاب ينكترس�لما دوزي ض�اخ وأا ماع ىرابتعا وأا ىعيبط ض�خس� لك\nتاــمولعلماو تاـــنايبلا نـــيزخت وأا ةــــلجاعبم موـــــقي وأا تاــــمولعلما ةــــينقت ةطس�اوب\n. اهيمدختس�م وأا تلاس�تلا ةمدخ نع ةــباين ةـــينوتركلإلا\n: ةيلالما ةقاطبلا - ل\nعـــفدلا وأا عادــيإلا وأا بـــحس�لا تاـــيلمع ىــــف لــمعتس�ي ض�وـــملم ىـــنوتركلإا طـــيس�و\nتاقاطبك ، تامولعلما ةينقت لئاس�و وأا ةيتامولعلما ةكبس�لا مادختس�اب ىنوت