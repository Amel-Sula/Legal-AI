. بكارلا أاطخ وأا ةرهاقلا ةوقلا تابثإاب لإا هتيلوؤوس�م يـفتنت لو ، ةيدام وأا\nعوــجرلا اذهل ناك اذإا ، لــقانلا ىلع عوجرلا لاوـــحألا عيمج يـف لقنلل ةــــلومعلاب لـــيكوللو\n. هربري ام\n) 47 ( ةداــلما\nايئزج وأا ايلك ةيلوؤوس�لما نم لقنلل ةلومعلاب ليكولا ءافعإاب يس�قي طرس� لك لاطاب عقي\nنوكي طرس� لك ةيلوؤوس�لما نم ءافعإلا مكح يـف دعيو ، ةيندب رارس�أا نم بكارلا قحلي امع\nليكولا ةيلوؤوس�م دس� ينمأاتلا تاقفن س�عب وأا لك عفدب هجو يأا ىلع بكارلا مازلإا هنأاس� نم\n. لقنلل ةلومعلاب\nلـقانلا وأا لــقنلل ةلومعلاب ليكولا نم مــيس�لجا أاطلخاو يدــمعلا أاطلخا يتلاح ادـــع اــميفو\nاــــيئزج وأا ايلك هءافعإا طترس�ي نأا لــــقنلل ةلومعلاب لــــيكولل زوجي ، امهيعبات دحأا نم وأا\nرــــيغ رارـــس�أا نم هقحلي امعو ، بـــكارلا لوـــس�و يـــف رـيخأاتلا نــــع ةــئس�انلا ةـــيلوؤوس�لما نـــم\nملعأا دـــق لقنلل ةلومعلاب ليكولا نوـــكي نأاو ، ابوتكم ءافعإلا طرس� نوـــكي نأا بجيو ، ةيندب\n. بكارلا وأا لكولما هب\n- 15 -\n\n) 48 ( ةداــلما\nررس�لا نع س�يوعتلاب هتبلاطلم ، لقانلا ىلع ةرس�ابم عوجرلا قح بكارلا وأا ، لكوملل\n، يرــــخأاتلا نـــعو هــل ةــفلاخلماب ذــيفنتلا نـــع وأا ، يرــبلا لقنلا دقع ذيفنت مدع نــع ئس�انلا\n. ىوعدلا يـف لقنلل ةلومعلاب ليكولا لاخدإا ، ةلالحا هذه يـف بجيو\nررـــس�لا نـــع س�ــيوعتلاب هـــتبلاطلم ، بــكارلا وأا ، لـــكولما ىــلع ةرـــس�ابم عوجرلا قح لـــقانللو\n. لقنلا ذيفنت نم هقلح يذلا\n) 49 ( ةداــلما\nلس�رلما نكي لم ام ، هطس�و يذلا ةلومعلاب ليكولل انماس� ةلومعلاب يلس�ألا ليكولا نوكي\n. يلس�ألا ليكولا عم هقافتا يـف طيس�ولا ليكولا ينع دق\n) 50 ( ةداــلما\n. قوقح نم هل اميف هلمح لح ، لقانلا لىإا لقنلا ةرجأا ةلومعلاب ليكولا عفد اذإا\n) 51 ( ةداــلما\nلقنلل ةلومعلاب ليكولا ىلع يرس�ت ، لس�فلا اذه يـف اهيلع س�وس�نلما ماكحألا ادع اميف\n. ةلومعلاب ةلاكولا دقعب ةس�الخا ماكحألا\nس�ــمالخا لــس�فلا\nس�ــيوعتلا س�ـــس�أا\n) 52 ( ةداــلما\nببس�ب لقانلا ىلع عوجرلا يـف هقح طقس�ي ، ظفتح نود عئاس�بلا هيلإا لس�رلما ملس�ت اذإا\n)7( للاخ عئاس�بلا ةلاح تبثي لم ام ، لوس�ولا يـف رخأاتلا وأا ، يئزلجا كلاهلا وأا ، فلتلا\nكلاهلا وأا ، فلتلا ناك اذإا اموي رس�ع ةعبرأا )14( للاخ وأا ، ملس�