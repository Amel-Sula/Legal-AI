  "title": "Land Transport System",
  "text": "نياطلــــس� موــــس�رم\n2016/10 مــقر\nيرـــبلا لـــقنلا نوــــناق رادــس�إاب\nناـمع ناـطلس� دـي عس� نـب س�وـباق نـحن\n، 96/101 مقر نياطلس�لا موس�رلماب رداس�لا ةلودلل يس�اس�ألا ماظنلا ىلع علاطلا دعب\n، 90/55 مقر نياطلس�لا موس�رلماب رداس�لا ةراجتلا نوناق ىلعو\n، نامع س�لمج ىلع س�رعلا دعبو\n. ةماعلا ةحلس�لما هيس�تقت ام ىلع ءانبو\nتآا وـــه اـــبم اـــنمس�ر\nىـــــلوألا ةداـــلما\n. قــفرلما يرــبلا لــقنلا نوــناق ماــكحأاب لــمعي\nةــــيناثلا ةداـــلما\n. ةيمس�رلا ةدـيرلجا يـف موــس�رلما اذــه رــس�ني\nـه1437 ةــنس� ىـلوألا ىداـمج نـم 26 : يـف ردـس�\nم2016 ةــنس� س�راـــــــــــــــــــــــم نـم 6 : قـــــفاولما\nديعس� نب س�وباق\nناـــمـع ناــطلـــس�\n- 1 -\n\nيرـــبلا لــقنلا نوــناق\nلوألا باــبلا\nةـــماع ماـــكحأاو تاـــفيرعت\n) 1 ( ةداــلما\nنــــيرق ينبــلما ىـــنعلما ةـــيلاتلا تاراـــبعلاو تاـــملكلل نوكي ، نوــــناقلا اذه ماكحأا قــــيبطت يـف\n: رخآا ىنعم س�نلا قايس� س�تقي لم ام ، اهنم لك\n: ةرازوــــــلا - أا\n. تلاس�تلاو لقنلا ةرازو\n: رــــــيزولا - ب\n. تلاـس�تلاو لقنلا ريزو\n: ةـــــــحئلالا - ج\n. نوناقلا اذهل ةيذيفنتلا ةحئلالا\n: ةأاـــــــــــس�نلما - د\n. يبرلا لقنلا ةطس�نأا ةلوازبم هل س�خرم نيوناق نايك\n: يرـــبلا لـــقنلا قــفارم - ـه\nنزو تاـــــطمحو ، لـــقنلل ةــــــماعلا تاـــــــطحلماك ، يرــبلا لـــــقنلاب ةــــــقلاع تاذ قـــــفارم\n، ةـــيبرلا ئـــناولماو ، ءاويإلا تاـــحاس�و ، طوطلخا تاراس�م ىلع فـــقاولماو ، تاــنحاس�لا\nةـــس�اخ ةـــيتس�جوللا تاــــمدلخا زكارمو ، قرطلاب ةـــقلعتلما تامدلخاو تازـــيهجتلاو\n. اهعيمتجو عئاس�بلا ةئزتجو ، اـهليمتحو عئاس�بلا غيرفت زكارم\n: يرـــــبلا لـــقنلا - و\nلخاد رخآا لىإا ناكم نم امهيلك وأا عئاس�بلا وأا باكرلا لقن هيلع بتتري طاس�ن يأا\n. يبرلا لقنلا لئاس�وب اهيلإا وأا اهنم وأا ةنطلس�لا\n: يرـــبلا لــقنلا لــئاس�و - ز\n. ةيلآا ةوقب يرس�تو ، تلاجع ىلع يرس�لل تدعأا لئاس�و\n- 2 -\n\n: عــــــئاس�بلا - ح\nاهلقن متي يتلا ءايس�ألا نم اهيرغ وأا ، تاناويلحاو ةعتمألاو تادعلماو داولماو علس�لا\n. ىرخأا لقن تادحو وأا ، تايواح يـف\n: لـــقنلا ةــــقيثو - ط\n. يبرلا لقنلا دقع تبثي ، لقانلا هردس�ي دنتس�م\n: بــــــــــــكارلا - ي\n. قئاس�لا فلاخب لقنتلا دس�قب يبرلا لقنلا ةليس�و يـف دوجولما س�خس�لا\n: لـــــــــس�رلما - ك\n. لقانلا عم يبرلا لقنلا دقع مبري يرابتعا وأا يعيبط س�خس�\n: هــيلإا لــــــس�رلما - ل\n. ةعاس�بلا ملس�تل لس�رلما هددحي ، يرابتعا وأا يعيبط س�خس�\n: لــــــــــقانلا - م\nباـــكرلل يرــــبلا لــــقنلا ةــــطس�نأا ةـــلوازبم هــــل س�خرم يرابتعا وأا يـــعيبط س�ــخس�\n. امهيلكل وأا عئاس�بلا وأا\n: يرـبلا لــقنلا ةـــطس�نأا - ن\n. يبرلا لقنلاب ةس�الخا ، ةرازولا لبق نم ةفنس�لماو ةدمتعلما ةطس�نألا\n: باـكرلل مظتنلما لقنلا - س�\nنــلعمو ةددــمح فــقوت طاقنو لقن طوـــطخو ةفرعتو تيقوتب ديقلما باـــكرلا لــــقن\n. ةرازولا لبق نم اقبس�م اهنع\n: لـــقنلل ةــماعلا تاـــطحلما - ع\nعـئاس�بلا لــقنل ةدــمتعم ةيـنف طورــس� قــفو ، ةرازولا لــبق نم ةددــمح ةماع تاـحاس�\n. ةلحرلل لوس�ولاو قلاطنلا ةطقن دعتو ، باكرلاو\n: ءاوـــــــيإلا تاـــــحاس� - ف\nلــقنلا لــئاس�و ءاوـــيإل ةدمتعم ةينف طورـس� قـــفو ، ةرازولا لبق نم ةس�خرم تاـــحاس�\n. يبرلا\n- 3 -\n\n: ةرــــهاقلا ةوــقلا - س�\n، اهعفد وأا ، اهبنتج نكيم لو ، ةرطيس�لا قاطن نع جرخت ةلاح وأا ، ثداح وأا ، لعف يأا\nراـــس�تناو ، بورـــلحاو ، ةيــعيبطلا ثراوــكلاك ، دـــــقعلا عـــيقوت دــــنع اـــهثودح عــقوت وأا\n. اهيرغو ، ةئبوألا\n: س�ـــــــيخترلا - ق\n. يرـبلا لـقنلا طاـس�ن ةـلوازبم ةرازوـلا نـم ةرداـس�لا ةـقفاولما\n: لـــــيغس�تلا ةــــقاطب - ر\nلمعلاب يبرلا لقنلا ةليس�ول حرس�ي اهاس�تقبم يتلا ةرازولا نم ةرداس�لا ةقيثولا\n. هل س�خرلما طاس�نلا لامج يـف\n: لـــقنلل ةــلومعلاب ةــلاكولا - س�\nلـــقن ىـلع لــقان عـم هــلكوم مـس�اب وأا هــمس�اب دقاعتي نأاب ليكولا هـــبجوبم مزــتلي دــقع\nةطبترلما تايلمعلاب ءاس�تقلا دنع موقي نأابو ، ةنيعم ةهج لىإا عئاس�ب وأا س�خس�\n. لكولما نم اهاس�اقتي ةلومع لباقم يـف كلذو ، لقنلا اذهب\n: يرـــبلا لــــقنلا دقــع - ت\nىرــخأا لىإا ةــهج نم بـــكار وأا ، ةـــعاس�ب لقنب موقي نأاب لقانلا هبجوبم مزتلي قافتا\n. ينعم رجأا لباقم يرب لقن ةليس�و ةطس�اوب\n) 2 ( ةداــلما\nاـــهمظنت يتلا ةــطس�نألا ادـــع اميف ، يبرلا لقنلا ةطس�نأا ىلع نوناقلا اذه ماــكحأا يرــس�ت\n. ةس�اخ ينناوق\n) 3 ( ةداــلما\nتاءارجإلال اقفو ، س�يخترلا ىلع لوس�لحا دعب لإا ، يبرلا لقنلا ةطس�نأا ةلوازم زوجي ل - أا\n. ةحئلالا اهنيبت يتلا طورس�لاو\nدارفألال لإا يبرلا لقنلا دوقعب دهعت نأا تايعملجاو ، تاكرس�لاو ، تاس�س�ؤولما ىلع رظحي - ب\nنوـــناقلا اذــه ماــكحأل اــقفو ، يبرلا لقنلا ةـــــطس�نأا ةـــلوازبم اــهل س�ـــخرلما تآاس�نلما وأا\n. ةحئلالاو\n- 4 -\n\n) 4 ( ةداــلما\n، اـــهريوطت ىـــلع لــــمعلاو يرـــبلا لـــقنلا قـــفارمو ةـــطس�نأا ىـلع فارـــس�إلا ةرازوــلا ىــلوتت\n: يتأاي ام س�وس�لخا هجو ىلع لىوتتو\nتاجايتحاو عاس�وأل ةــمزلالا تاس�اردلاو يرــبلا لقنلل ةــلماس� ةـيجيتاترس�ا دادعإا - أا\nلوـــللحا عــس�وو ، اــهنيب اميفو تاظفاحلماو تاــيلولا لخاد يرــبلا لقــنلا تاـــمدخ\n. اهل ةبس�انلما تالجاعلماو\nاهب ةــس�الخا ةــينفلا تافس�اولماو طورــس�لاو ، يرــبلا لــقنلا قفارم عـقاوم دــيدتح - ب\n. ةحئلالا هنيبت اـلم اقفو ، ةينعلما تاهلجا عم قيس�نتلاب\nاهنيب اميفو تاظفاحلماو تايلولا لخاد يبرلا لقنلل ةيس�يئرلا طوطلخا ديدتح - ج\n. ةينعلما تاهلجا عم قيس�نتلاب\n. ةينعلما تاهلجا عم قيس�نتلاب ، ليودلا لقنلل اهب حومس�لما طوطلخاو تاراس�لما ديدتح - د\n. س�يخترلا رادس�إا - ـه\n. ةحئلالا اهنيبت يتلا طباوس�لاو طورس�لل اقفو ، ليغس�تلا ةقاطب رادس�إا - و\nيرــبلا لــقنلا لــئاس�وو تآاـــس�نلما نع لـــيس�افتلا ةـــفاك اــهيف نودــت تلاجس� دادعإا - ز\n. ةحئلالا هنيبت اـلم اقفو ، يبرلا لقنلا ةطس�نأا ةلوازبم اهل س�خرلما\n، ةينعلما تاهلجا عم قيس�نتلاب ، يبرلا لقنلا ةملاس�ب ةس�الخا تاطاترس�لا ديدتح - ح\n. ةحئلالا هنيبت اـلم اقفو\nتارارقلاو نوناقلا اذه ماكحأل اقبط اهمدقت يتلا تامدلخا موس�ر رادقم ديدتح - ط\n. ةيلالما ةرازو ةقفاوم دعب ، هل اذيفنت ةرداس�لا\n. ةحئلالا هنيبت اـلم اقفو ، لقنلا ةرجأا ديدتح - ي\nةلجس�لما يرغ يبرلا لقنلا لئاس�وب لقنلل ةمظنلما تاطاترس�لاو دعاوقلا ديدتح - ك\n. كلذل ةمظنلما تايقافتلاب للاخإلا مدع عم ، ةحئلالا هنيبت اـلم اقفو ، ةنطلس�لا يـف\n- 5 -\n\n) 5 ( ةداــلما\nتاططخلماو تاس�اردلا عيراس�م نأاس�ب ةرازولا عم قيس�نتلا ، طيطختلاب ةس�تخلما تاهلجا ىلع\n. يبرلا لقنلا ةطس�نأاب ةقلاعلا تاذ ةيليس�فتلا\n) 6 ( ةداــلما\nقاــــفتلاب ةـــس�تخلما ةـــطلس�لا نم رارـــق مــهديدحتب ردـــس�ي نيذلا ةرازوــــلا يـفظولم نوـــكي\nتارارقلاو ةحئلالاو نوناقلا اذه ماكحأا قيبطت يـف ةيئاس�قلا ةيطبس�لا ةفس� ، ريزولا عم\n. هل ةذفنلما\nيــناثلا باــبلا\nيرـــبلا لــقنلا دــقع\nلوألا لــس�فلا\nةـــماع ماــكحأا\n) 7 ( ةداــلما\n. تابثإلا قرط ةفاكب يبرلا لقنلا دقع تابثإا زوجي\n) 8 ( ةداــلما\nةحارس� - نافرطلا قفتا اذإا لإا ، يبرلا لقنلا دقع ىلع قافتلا دنع لقنلا ةرجأا قحتس�ت\n. لوس�ولا وأا ميلس�تلا تقو لىإا اهقاقحتس�ا يرخأات ىلع - انمس� وأا\n) 9 ( ةداــلما\nةعيبط نكت لم ام ، ةحئلالا اهنيبت يتلا تانايبلا نمس�تت لقن ةقيثو رادس�إاب لقانلا مزتلي\nةقيثو دعتو ، كلذ فلاخ ىلع نافرطلا قفتي وأا ، لقن ةقيثو رادس�إا مدع يس�تقت لقنلا\nقرط ةفاكب اهيف درو ام س�كع تابثإا زوجيو ، لقانلا لىإا ةيلوؤوس�لما لاقتنا ىلع لايلد لقنلا\n. تابثإلا\n- 6 -\n\n) 10 ( ةداــلما\nلوبقب مزتلا ، ةنيعم طوطخ ىلع لقنلا وأا ، لقنلا نم ينعم عون ىلع زايتما لقانلل ناك اذإا\nناك اذإا وأا ، لقنلل ةررقلما طورس�لل افلامخ بلطلا ناك اذإا لإا ، تابلط نم هيلإا مدقي ام لك\n. هتدارإا نع ةجراخ بابس�أل ، هذيفنت لقانلا ىلع رذعتي\n) 11 ( ةداــلما\nلاعفأاو تافرس�ت نعو ، مهلاعفأاو مهتافرس�ت نع ينلوؤوس�م يبرلا لقنلا دقع فارطأا نوكي\nهمدختس�ي س�خس� لك اعبات دعيو ، مهلامعأاب مهمايق ببس�ب وأا ءانثأا يـف عقت يتلا مهيعبات\nطرس� لك لاطاب عقيو ، يبرلا لقنلا دقع ىلع ةبتترلما تامازتللا ذيفنت يـف فارطألا دحأا\n. كلذ فلاخب يس�قي\n) 12 ( ةداــلما\nةـــلاكولا دــقع وأا ، يرــبلا لقنلا دقع نع ةــــئس�ان ىوــعد لــك ةــيدلايم ةــنس� رورـبم مداــقتت\nيلكلا كلاــــهلا نع ةيلوؤوس�لما ىوعدب قلعتي اــميف مداقتلا اذه يرس�يو ، لـــقنلل ةـــلومعلاب\nهيف بجي يذلا مويلا نم وأا ، ميلس�تلا موي نم عئاس�بلل فلتلا وأا ، يرخأاتلا وأا ، يئزلجا وأا\n. هيلإا لس�رلما فرس�ت تتح ةعاس�بلا هيف تعس�و يذلا مويلا نم وأا ، ميلس�تلا\n، مـــيس�ج أاـــطخ وأا ، يدــــمع أاطخ وأا ، س�ـــغ هــنم ردــس� نم مداــــقتلاب كــس�متي نأا زوــــجي لو\n. كلذ فلاخ ىلع قافتا لك لاطاب عقيو\nيــناثلا لــس�فلا\nباــكرلا لــقن دــقع\n) 13 ( ةداــلما\nفلاــخ تــبثي مــل ام ، لــقانلا نم رداس�لا س�رعلل لوبق لقنلا ةليس�و بكارلا دوــعس� دـــعي\n. تابثإلا قرط ةفاكب باكرلا لقن دقع تابثإا زوجيو ، كلذ\n) 14 ( ةداــلما\nداعيلما يـف وأا هيلع قفتلما داعيلما يـف لوس�ولا ةهج لىإا هتعتمأاو بكارلا لقنب لقانلا مزتلي\n. هيلع فراعتلما وأا لقنلا ةقيثو يـف ينعلما دلحا ىلع ةعتمألا ديزت لأا ىلع ، لوقعلما\n- 7 -\n\n) 15 ( ةداــلما\nلقانلا بلاطي نأا بكارللو ، اهيلع قفتلما ةجردلا ىلع اناكم بكارلل ئيهي نأاب لقانلا مزتلي\nةقيثو يـف اهيلع قفتلما ةجردلا نم ىندأا ةجرد ىلع رفس�لا لىإا رطس�ا اذإا ، قرفلا دادترس�اب\n. لقنلا\n) 16 ( ةداــلما\nتـــقولا نــم يرـــبلا لقنلا دقع ذـــيفنت ءاـــنثأا يـف بـــكارلا ةــــملاس� نامس�ب لـــقانلا مزـــتلي\n، اهنم اهيف لزني يتلا ةظحللا يـف يهتنيو ، لقنلا ةليس�و لوخدب بكارلا هيف عرس�ي يذلا\nذــيفنت ءانثأا يـف ةــيندب رارــــس�أا نم هب قحلي ام وأا بكارلا ةافو نع لوؤوس�م لقانلا نوكيو\nبابس�أا ىــلإا عــجري كلذ نأا تــبثي مــل اــم ، لوــس�ولا يـف يرخأاتلا نعو ، يبرلا لـــقنلا دــقع\n. بكارلا لبق نم أاطلخ وأا هتدارإا نع ةجراخ\n) 17 ( ةداــلما\nس�قنلا وأا فلتلا وأا يئزلجا وأا يلكلا كلاهلا وأا دقفلا نع بكارلا س�يوعتب لقانلا مزتلي\n، يبرلا لقنلا دقع ذيفنت ءانثأا يـف لقنلا ةقيثو يـف ةلجس�لما ةعتمألا يـف بيع ثودح وأا\nةطس�اوب دعي رس�حبم ةلالحا تاـــبثإاو ، هـــنيح يـف لقانلا غلابإاب بـــكارلا موقي نأا طرس�ب\n. ميلس�تلا تقو ةعتمألا ةلاحو ةميقل س�يوعتلا عس�خيو ، ةرازولا فظوم\n) 18 ( ةداــلما\nس�ــــــقنلا وأا فــــلتلا وأا يــــئزلجا وأا يــــلكلا كلاهلا وأا دــــقفلا نــــع لوؤوـــس�م لــــقانلا نوــــكي ل\nلــــقانلا أاــــطخ بــــــكارلا تبثأا اذإا لإا ، بكارلا اـــهب ظفتحي يتلا ةعتمألا يـف بــيع ثودح وأا\n. عئاس�بلا لقنب ةس�الخا ماكحألا لقنلا ةقيثو يـف ةلجس�لما ةعتمألا ىلع يرس�يو ، هيعبات وأا\n) 19 ( ةداــلما\nامع وأا ةافولا نع ةيلوؤوس�لما نم ايئزج وأا ايلك لقانلا ءافعإاب يس�قي طرس� لك لاطاب عقي\nنوـــكي طرس� لـــك ةيلوؤوس�لما نم ءافعإلا مكح يـف دعيو ، ةيندب رارس�أا نم بـــكارلا بـــيس�ي\nينمأاتلا تاقفن س�عب وأا لك ةيطغت اهنم فدهلا نوكي غلابم يأا عفدب بكارلا مازلإا هنأاس� نم\n. لقانلا ةيلوؤوس�م دس�\n- 8 -\n\nلقانلل زوجي ، هيعبات نم وأا لقانلا نم ميس�لجا أاطلخاو يدمعلا أاطلخا يتلاح ادع اميفو\nرارس�أا وأا ةيندبلا يرغ رارس�ألا نع ةئس�انلا ةيلوؤوس�لما نم ايئزج وأا ايلك هءافعإا طترس�ي نأا\nلـــقانلا نوكي نأاو ، اــبوتكم ءاــفعإلا طرس� نوكي نأا بــجيو ، بــــكارلا لوـــس�و يـف رـــيخأاتلا\n. بكارلا هب ملعأا دق\n) 20 ( ةداــلما\nلـــقنلا ةرـــجأا قحتس�ي لو ، يرـــبلا لـــقنلا دــقع ذـيفنت مدــع نـع لوؤوــــس�م لقانلا نوـــكي ل\n، حاورألا ىــلع ارطخ هذيفنت لــعتج فورـــظ تأارـــط وأا ، هذـــيفنت نود ةرـــهاق ةوـــق تـــلاح اذإا\n، يرـــــــــبلا لـــقنلا دقع ذــــيفنت ءاــنثأا يـف حاورألا ىـلع رـــطلخا وأا ةرــــهاقلا ةوـــقلا تــــماق اذإاو\n. يبرلا لقنلا دقع نم هذيفنت تم يذلا ءزلجا نع لإا لقنلا ةرجأا لقانلا قحتس�ي لاف\n) 21 ( ةداــلما\nلـــــقانلا مزـــتلا ، يبرلا لقنلا دـــقع ذـــيفنت ءانثأا يـف س�رــــبم بيس�أا وأا بـــكارلا يـــفوت اذإا\n، نأاس�لا يوذل اهميلس�ت ينح لىإا بكارلا ةعتمأا ىلع ةظفاحملل ، ةمزلالا يربادتلا ذختي نأاب\nهذــــه ةـــبقارلم لـــــخدتي نأا هل زاج ، بكارلاب ةــــقلاعلا يوذ دـحأا ةاـفولا ناكم يـف دجو اذإاو\n. هتزايح يـف تراس� دق ىفوتلما ةعتمأا نأاب ارارقإا هميلس�ت لقانلا نم بلطي نأاو ، يربادتلا\n) 22 ( ةداــلما\nتاــــقفنلا نم اــــهيرغو لــــقنلا ةرـــجأل اــــنامس� ةـــلجس�لما بــكارلا ةعتمأا زجح لقانلل زوــــجي\nءاــــفيتس�ل ، ةــعتمألا هذه نمث ىلع زاـــيتملا قـــح لـــقانللو ، لــقنلا ببس�ب هــل قـحتس�ت يتلا\nءاـــيس�ألا ىلع ذــيفنتلا تاءارجإا نأاـــس�لا اذه يـف عبتيو ، لقنلا ببس�ب هـــل ةقحتس�لما غـــلابلما\n. ايراتج انهر ةنوهرلما\n) 23 ( ةداــلما\nةــلماك لــقنلا ةرجأا ءادأابو ، لـــقنلاب ةقلعتلما لقانلا تاميلعتو حــــئاول عابتاب بكارلا مزــــتلي\nلاحتس�ا اذإا امأا ، رفس�لا نع لدع ولو فرعلا هب يس�قي يذلا وأا ، هيلع قفتلما داعيلما يـف\nلقنلا دـــقع نإاف ، ةـــيرهقلا عناولما نم كلذ يرغ وأا هس�رم وأا بكارلا ةافو ببس�ب رفس�لا\n. لقنلا ةرجأا بتج لو ، خس�فني يبرلا\n- 9 -\n\nرفس�لا نع هلودعب لقانلا رطخأا اذإا لقنلا ةرجأاب بكارلا مزتلي ل ، مظتنلما لقنلا تلاح يـفو\nنود رفس�لا نع بكارلا لدع اذإاو ، ةعاس� نيرس�عو عبرأا )24( ـب لقنلل ددحلما داعيلما لبق\nنكي لم ام ، ةلماك لقنلا ةرجأا عفدب مزتلا ، داعيلما اذه ةاعارم نود وأا كلذب لقانلا راطخإا\nرـــفس�لا ةـــلس�اوم نع بـــكارلا لدع اذإا امأا ، ةرـــهاق ةوـــق وأا س�رلما وأا ةاــفولا ببس�ب هـــلودع\n. ةلماك لقنلا ةرجأا هيلع تقحتس�ا ، هئدب دعب\n) 24 ( ةداــلما\nةرجألا دادترس�اب لقانلا ةبلاطم هل زاج ، ةس�اخ ايازم لباقم ةيفاس�إا ةرجأا بكارلا عفد اذإا\n. اهيلع قفتلماو اهلباقت يتلا ايازلما لقانلا هل رفوي لم اذإا ، ةيفاس�إلا\n) 25 ( ةداــلما\n، همس�اب ةقيثولا نكت لم ام ، لقنلا ذيفنت ءدب لبق لقنلا ةقيثو نع لزانتلا بكارلل زوجي\n. ةس�اخ تارابتعل هل تيطعأا وأا\nثـــلاثلا لــس�فلا\nعــئاس�بلا لــقن دــقع\n) 26 ( ةداــلما\nتبثي لم ام ، لس�رلما نم رداس�لا س�رعلل هنم لوبق لقنلا لمح عئاس�بلل لقانلا ملس�ت دعي\n. تابثإلا قرط ةفاكب عئاس�بلا لقن دقع تابثإا زوجيو ، كلذ فلاخ\n) 27 ( ةداــلما\n، لقنلا ةقيثو يـف امهيلع قفتلما تقولاو ناكلما يـف لقانلا لىإا عئاس�بلا ميلس�تب لس�رلما مزتلي\nهراطخإا لس�رلما ىلع بجو ، ةس�اخ تادادعتس�ا لقانلا بناج نم يس�تقي لقنلا ناك اذإاو\n. فاك تقوب ميلس�تلا لبق ، كلذب\n) 28 ( ةداــلما\nتانايبلا ةحس� نمو ، اهتلاح نم ققحتلل ، اهلقن بولطلما عئاس�بلا س�حف لقانلل زوجي\nنود اهلقنب حمس�ت ل عئاس�بلا ةلاح نأا س�حفلا نم ينبت اذإاو ، لس�رلما نم هيلإا ةمدقلما\n- 10 -\n\nةــــلاحب هــملعب ةـــباتك لـــس�رلما رقي لم ام ، لقنلا نع عانتملا لـــقانلل زاج ، ررــس�ل اــهس�رعت\n. كلذ يرغ ىلع قفتي لم ام س�حفلا تافورس�م لقانلا لمحتيو ، لقنلاب هئاس�رو عئاس�بلا\n) 29 ( ةداــلما\nيس�تقت يتلا عئاس�بلا دادعإاب همايق مدع نع أاس�نت يتلا رارس�ألا نع لوؤوس�م لس�رلما نوكي\nس�اــــخس�ألاب قـــحلت يتلا رارس�ألا نعو ، كلاـــهلا وأا فــلتلا اـهيقي اـس�اخ ادادعإا اــــهتعيبط\nاذإا ، رارس�ألا هذه نع لوؤوس�م لقانلا نوكي ، كلذ عمو ، اهعم لقنت يتلا ىرخألا عئاس�بلا وأا\n. هيف هلامهإا وأا س�الخا دادعإلا اذهب لس�رلما مايق مدعب هملع ناكمإا وأا هملع عم لقنلا لبق\n) 30 ( ةداــلما\nهنيع يذلا داعيلما يـف ملس�تلا نع هـــيلإا لس�رلما فلخت وأا ، هذيفنت ءانثأا يـف لقنلا فقوأا اذإا\nلقانلا ىلع بجو ، تافورس�لماو لقنلا ةرجأا عفد نع وأا ملس�تلا نع عنتماو رس�ح وأا ، لقانلا\nلــــقانلا غلاـــبإا يـف لـــس�رلما رـــخأات اذإاو ، هتاميلعت هنم بلطي نأاو ، كلذــب لــس�رلما رــطخي نأا\nرـــيبخ ينــيعت ةـــس�تخلما ةمكحلما نم بلطي نأا لقانلل زاـــج ، بــــس�انلما تقولا يـف هــــتاميلعت\nهنيع