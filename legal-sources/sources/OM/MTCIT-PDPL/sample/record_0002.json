  "text": ")١٥٩١( ددعلا ةيمس�رلا ةديرلجا\nنياطلــــس� موــــس�رم\n٢٠٢٥/٣٩ مــقر\nةــينوتركلإلإا تلاــماعلما نوــناق رادــس�إاب\nناـمع ناـطلس� قر اــط نــب مــثيه نـحن\n،ةلودلل يس�اس�ألأا ماظنلا ىلع علاطلأا دعب\n،2008/69 مقر نياطلس�لا موس�رلماب رداس�لا ةينوتركلإلأا تلاماعلما نوناق ىلعو\n،نامع س�لمج ىلع س�رعلا دعبو\n،ةماعلا ةحلس�لما هيس�تقت ام ىلع ءانبو\nتآا وــــه اـــبم اـــنمس�ر\nىــــلوألإا ةداــلما\n.قفرلما ةينوتركلإلأا تلاماعلما نوناق ماكحأاب لمعي\nةـــيناثلا ةداــلما\n،قــــفرلما نوــــناقلل ةيذيفنتلا ةــحئلالا تامولعلما ةينقتو تلأاــــس�تلأاو لــــقنلا رــــيزو ردــــس�ي\n.هماكحأا ذيفنتل ةمزلالا تارارقلا ردس�ي امك\nةـــثلاثلا ةداــلما\n،قفرلما نوناقلا فلاخي ام لك ىغلي امك ،هيلإا راس�لما ةــينوتركلإلأا تلاــماعلما نوــناق ىــغلي\n.هماكحأا عم س�راعتي وأا\nةـــعبارلا ةداــلما\n.هرس�ن خيراتل لياتلا مويلا نم هب لمعيو ،ةيمس�رلا ةديرلجا يـف موس�رلما اذه رس�ني\nـه١٤٤٦ ةـنس� لاوـــــــــــــس� نـم ١٠ :يـف ردـس�\nم٢٠٢٥ ةـنس� لــــــــــــيربأا نـم ٩ :قــــفاوـلما\nقراــط نب مــثيه\nناـــمـع ناطلـــس�\n\n)١٥٩١( ددعلا ةيمس�رلا ةديرلجا\nةــينوتركلإلإا تلاــماعلما نوــناق\nلوألإا لس�فلا\nةــماع ماــكحأاو تاــفيرعت\n) ١ ( ةداــلما\n،اهنم لك نيرق ينبلما ىنعلما ةيتآلأا تارابعلاو تاملكلل نوكي ،نوناقلا اذه ماكحأا قيبطت يـف\n:رخآا ىنعم س�نلا قايس� س�تقي لم ام\n:ةرازولا - ١\n.تامولعلما ةينقتو تلأاس�تلأاو لقنلا ةرازو\n:ريزولا - ٢\n.تامولعلما ةينقتو تلأاس�تلأاو لقنلا ريزو\n:ةينوتركلإلإا ةقيثولا - ٣\n،هنيزخت وأا ،هؤواس�نإا متي رـــخآا دـــنتس�م يأا وأا ةـــلاس�رلا وأا ،لـــجس�لا وأا ،دـــيقلا وأا ،دــقعلا\n.ةينوتركلإا ةليس�وب ايلك وأا ايئزج هملس�ت وأا ،هغلابإا وأا ،هلاس�رإا وأا ،هخس�ن وأا ،هجارختس�ا وأا\n:ةينوتركلإا ةليس�و - ٤\nاــهنيزخت وأا ةــــينوتركلإلأا تاـــنايبلا وأا تاـــمولعلما ةـــلجاعلم مدـــختس�ت ةـــينوتركلإا ةادأا\n.لاس�تلأاو ليآلأا بس�الحا ةزهجأاو ةمظنأا اهنمو ،اهلابقتس�ا وأا اهلاس�رإا وأا\n:ةينوتركلإلإا ةلماعلما - ٥\nايلك وأا ايئزج هذيفنت وأا هؤوارجإا متي ةينوتركلإا ةقيثوب لس�تي قافتا وأا ءارجإا يأا\n.ةينوتركلإا ةليس�و ةطس�اوب\n:ةينوتركلإلإا تانايبلا وأا تامولعلما - ٦\n،هلكس� ناك ايأا ةينوتركلإا ةليس�وب هلقن وأا هتلجاعم وأا هنيزخت وأا هؤواس�نإا نكيم ام لك\n.فورلحاو تارفس�لاو ماقرألأاو تاراس�إلأاو زومرلاو تاوس�ألأاو روس�لاو ةباتكلاك\n:ئس�نلما - ٧\nلس�رت وأا ،ةينوتركلإا ةقيثو لس�ري وأا ئس�ني يذلا يرابتعلأا وأا ،يعيبطلا س�خس�لا\n.حيحس� س�يوفت ىلع ءانب هنع ةباين\n\n)١٥٩١( ددعلا ةيمس�رلا ةديرلجا\n:هيلإا لس�رلما - ٨\n.هيلإا هتلاس�ر هيجوت ئس�نلما دس�ق يذلا يرابتعلأا وأا يعيبطلا س�خس�لا\n:طيس�ولا - ٩\n،ملس�ت وأا ،لاس�رإاب رخآا س�خس� نع ةباين موقي يذلا يرابتعلأا وأا يعيبطلا س�خس�لا\n.ةلماعلما كلتب قلعتت تامدخ ذيفنتب موقي وأا ،ةينوتركلإلأا ةلماعلما ظفح وأا\n:ليآلإا نيوتركلإلإا طـيس�ولا - ١٠\nذيفنت لجأا نم مدختس�ت ىرخأا ةينوتركلإا ةليس�و يأا وأا ،نيوتركلإا ماظن وأا جمانرب\nةينوتركلإا ةقيثو ملس�ت وأا ،لاس�رإا وأا ،ءاس�نإا دس�قب كلذو ،هل ةباجتس�لأا وأا ،ءارـــجإا\n.يعيبط س�خس� لخدت نود\n:ةقثلا تامدخ - ١١\n.نوناقلا اذه نم )2٤( ةدالما يـف اهيلع س�وس�نلما تامدلخا\n:ةقثلا تامدخ مدقم - ١٢\n.ةقثلا تامدخ يمدقتب دمتعلما وأا هل س�خرلما يرابتعلأا س�خس�لا\n:ةينوتركلإلإا تامدلخا دوزم - ١٣\n.هتامدخ يمدقت يـف ةقثلا تامدخ ىلع دمتعي يذلا يرابتعلأا وأا يعيبطلا س�خس�لا\n:نيوتركلإلإا ناونعلا - ١٤\nنيوانعلاو نيوتركلإلأا ديبرلاك ةينوتركلإا ةقيثو ملس�تو لاس�رإلأ ةينوتركلإا ةليس�و\n.تلاس�ارلما ةمظنأا يـف ةمدختس�لما\n:طيس�بلا نيوتركلإلإا عيقوتلا - ١٥\n،فورــــــح لـــــكس� يــــف ةـــينوتركلإلأا ةــــــلماعلما وأا ةــينوتركلإلأا ةــــــقيثولا ىلع عــــيقوتلا\n.اهيرغ وأا تاراس�إا وأا زومر وأا ماقرأا وأا\n:مدقتلما نيوتركلإلإا عيقوتلا - ١٦\nهزييتمو عقولما س�خس�لا ةيوه ديدحتب حمس�ي ،درفتم عباط وذ نيوتركلإا عيقوت\n.هيرغ نع\n:دمتعلما نيوتركلإلإا عيقوتلا - ١٧\n.نيوتركلإلأا قيدس�تلا ةداهس�ب طبترمو مدقتم نيوتركلإا عيقوت\n\n)١٥٩١( ددعلا ةيمس�رلا ةديرلجا\n:نيوتركلإلإا عيقوتلا ءاس�نإا ةادأا - ١٨\n.نيوتركلإلأا عيقوتلا ءاس�نإلأ امهمادختس�ا متي ،نيوتركلإا زاهج وأا ةزهمج ةيمجرب\n:عـقولما - ١٩\nهس�وفي نمع وأا ،هس�فن نع عيقوتلاب موقي يذلا يرابتعلأا وأا ،يعيبطلا س�خس�لا\n.هب ةس�اخ نيوتركلإا عيقوت ءاس�نإا ةادأا مادختس�اب كلذو ،انوناق هلثيم نم وأا\n:ةينوتركلإلإا ةيوهلا ماظن - ٢٠\nةدافتس�لأاو ةينوتركلإلأا تامدلخا يدوزم ةمظنألأ لوخدلا س�خس�لل حيتت ةموظنم\n.اهتامدخ نم\n:نيوتركلإلإا متلخا - ٢١\nةــيوه ديكأات س�رغب ةينوتركلإلأا ةــــقيثولاب ةطبترم وأا ةـــقحلم ةـــينوتركلإا تاــنايب\n.اهيف ةدراولا تانايبلا وأا ةقيثولا ردس�م ةملاس�و لس�أاو ئس�نلما\n:نيوتركلإلإا ققحتلا ةادأا - ٢٢\nس�ــخس�لا ةــــيوه دـــيكأات س�رـــغب ةيس�خس� فيرعت تاـــنايب وأا لـــماوع نــمس�تت ةادأا\n.انوناق هلثيم نم وأا هنع بوني نم وأا يرابتعلأا وأا يعيبطلا\n:يرفس�تلا - ٢٣\n،ءورقم وأا فورعم يرغ س�ن ىلإا ةينوتركلإلأا تاـــنايبلا وأا تاــمولعلما ليوتح ةــــيلمع\nنم يرفس�تلا كف وأا يرفس�تلا حاتفم نولمحي نيذلا س�اخس�ألأا طقف نكيم ابم\n.يلس�ألأا س�نلا ىلإا لوس�ولا\n:يرذلجا حاتفلما - ٢٤\nقـــيدس�تلا تاداــــهس� ءاـــس�نإلأ ةــــقثلا تاـــمدخ مدــقم اــهمدختس�ي ةـــينوتركلإا ةـــليس�و\n.نيوتركلإلأا عيقوتلا ءاس�نإا تانايبو نيوتركلإلأا\n:نيوتركلإلإا قيدس�تلا ةداهس� - ٢٥\nتاـــنايبو عــقولما تانايب نــمس�تت ةـــقثلا تامدخ مدـــقم اهردس�ي ةينوتركلإا ةـــقيثو\n.دمتعلما نيوتركلإلأا هعيقوت\n:ةحئلالا - ٢٦\n.نوناقلا اذهل ةيذيفنتلا ةحئلالا\n\n)١٥٩١( ددعلا ةيمس�رلا ةديرلجا\n) ٢ ( ةداــلما\n.ةقثلا تامدخو ةينوتركلإلأا تاعيقوتلاو قئاثولاو تلاماعلما ىلع نوناقلا اذه ماكحأا يرس�ت\n) ٣ ( ةداــلما\nهـــــتايلمعب ماــــيقلا يـف يــــنامعلا يزـــكرلما كـــنبلا ةيللاقتس�اب نوــــناقلا اذــــه ماكحأا لـــخت لأ\n،هــتباقرو هــفارس�إلأ ةعس�الخا ةـــيلالما تاس�س�ؤولماو ةـــس�خرلما فراس�لما تاــيلمع مــيظنت يـفو\n.اهتمظنأا ىلإا لوخدلاو ،تاهلجا كلتب ةقلعتلما تانايبلاو تامولعلما ةيرس�بو\n) ٤ ( ةداــلما\nس�يئر نم لـــكس�ت ،\"ةـــقثلا تاــمدخ ةرادإا ةــنلج\" ىمس�ت ةنلج رـيزولا نم رارقب ةرازولا يـف أاس�نت\n.اهلمع ماظن ةحئلالا ددتحو ،ةبرلخا يوذ نم ءاس�عألأا نم ددعو\n) ٥ ( ةداــلما\n:يتآلأاب ةقثلا تامدخ ةرادإا ةنلج س�تخت\nتاــمدخ اــميس� لأ ،ةــقثلا تامدخ مــيدقتب ةــقلعتلما تاءارجإلأاو طــباوس�لا داــمتعا - ١\n.مهتاجايتحا عم بس�انتي ابم ،ةقاعإلأا يوذ س�اخس�ألال ةمدقلما ةقثلا\n،ةـــينوتركلإلأا ةـــيوهلا ةــمظنأاب ةــقلعتلما يرــياعلماو تاءارـــجإلأاو طــباوس�لا داــمتعا - 2\nتاهـــلجا عـــم قـــيس�نتلا دــعب كلذو ،ةـــينوتركلإلأا ةـــيوهلا نـــم قـــقحتلا تاءارـــــجإاو\n.ةقلاعلا تاذ\nةـــــقفاولماو ،ةــــــقثلا تامدخ مــــيدقت س�ـــــيخارت ءاــــــغلإاو ،فاــقيإاو ،دــــيدتجو ،حـــنم - ٣\n.ةحئلالا هنيبت يذلا وحنلا ىلع ،اهنع لزانتلا ىلع\n،هـــنع ةرداـــس�لا تاداــهس�لاب فارــتعلأاو ،يــبنجألأا ةـــقثلا تاـــمدخ مدــــقم داــــمتعا - ٤\n.ةحئلالا هنيبت يذلا وحنلا ىلع كلذو\nحـــيتافلما داــمتعاو ،اــهل س�ــخرلما تاــهجلل ةــيرذلجا حــيتافلما ءاــس�نإا ىلع ةــقفاولما - ٥\n.تاهلجا كلت اهئس�نت يتلا ةيرذلجا\n.ةقثلا تامدخ يمدقم ةطس�نأا ىلع قيقدتلا ريراقت دامتعا - 6\n.ةقثلا تامدخ يمدقم لجس� دامتعا - ٧\n\n)١٥٩١( ددعلا ةيمس�رلا ةديرلجا\n) ٦ ( ةداــلما\nريزولا عم قافتلأاب ةس�تخلما ةطلس�لا نم رارق مهديدحتب ردس�ي نيذلا ةرازولا يفظولم نوكي\nتارارــــقلاو ةـــحئلالاو نوــــناقلا اذه ماـــكحأا قيبطت قاــــطن يـف ةــــيئاس�قلا ةــــيطبس�لا ةــفس�\n.هماكحألأ اذيفنت ةرداس�لا\n) ٧ ( ةداــلما\nحاتفم بحاس� ىلع بجي ،ينطولا نمألأا س�لمج اهددحي يتلا يرفس�تلا حيتافم ءانثتس�اب\nةــيرورس�لا تاــمولعلما س�ـــحف نم ةــيئاس�قلا ةيطبس�لا ةــفس� ينـلوخلما ينكتم رـيفس�تلا\n.حاتفلماب ةقلعتلما\nيـناثلا لـس�فلا\nةــينوتركلإلإا تلاــماعلما\n) ٨ ( ةداــلما\nاهئاس�نإا يـف رفوت اذإا ،ةينوناقلا اهراثآا جتنتو ،ةبوتكم ةقيثو ةينوتركلإلأا ةقيثولا برتعت\nاذيفنت ةرداس�لا تارارقلاو ةحئلالاو نوناقلا اذه يـف اهيلع س�وس�نلما طورس�لا اهدامتعاو\n.هماكحألأ\n) ٩ ( ةداــلما\nطورس�لا ترفوت اذإا ةينوتركلإلأا تانايبلا وأا تامولعلما وأا ةينوتركلإلأا ةقيثولا ظفح ققحتي\n:ةيتآلأا\nتلس�رأا وأا تئس�نأا يذلا لكس�لا يـف اينوتركلإا تانايبلا وأا تامولعلما وأا ةقيثولا ظفح - ١\nءارــــجإا مدـــع نـــمس�ي لـــكس� يأا يـف وأا ،رــــفس�م لـــكس�ب وأا ،لس�ألأا يـف هــــب تـــملس�ت وأا\n.اهاوتمح ىلع ليدعت وأا يريغت يأا\nاــهيلإا لوــس�ولا حــيتي وحن ىلع ةظوفمح تانايبلا وأا تامولعلما وأا ةـــقيثولا ءاـــقب - 2\n.تقو يأا يـف اهيلإا عوجرلاو اهمادختس�او\nئس�نلما ىلع فرعتلا نم نكتم ةقيرطب تانايبلا وأا تامولعلما وأا ةقيثولا ظفح - ٣\n.اهملس�ت وأا اهلاس�رإا وأا اهئاس�نإا تقوو خيراتو ،هيلإا لس�رلماو\nظفحب قلعتي رخآا نوناق يأا يـف هيلع س�وس�نم مكح يأاب ةقباس�لا ةرقفلا م