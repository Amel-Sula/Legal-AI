 ﺩﻤﻌﻝﺍ ﻪﺒﺸ ﺔﻴﺩ ﺎﻤﺃ , ﻪﺌﺎﻴﻝﻭﺃ\n. ﻥﻭﻘﺤﺘﺴﻤﻝﺍ ﺎﻬﺒﻠﻁ ﺍﺫﺇ ﺔﻤﺯﻼﻝﺍ ﺔﻝﺎﻔﻜﻝﺍ ﻡﻴﺩﻘﺘ ﺔﻴﺩﻝﺍ\n1983 5\n. ﺔﻨﺴﻝ ﺔﻴﻨﺩﻤﻝﺍ ﺕﺍﺀﺍﺭﺠﻹﺍ ﻥﻭﻨﺎﻗ ﻡﺎﻜﺤﻷ ﺎﹰﻘﻓﻭ ﺔﻴﺩﻝﺍ ﻰﻓﻭﺘﺴﺘ ( )\n. ﺽﻴﻭﻌﺘﻝﺍ ﻭﺃ ﺔﻌﻔﻨﻤﻝﺍ ﻭﺃ لﺎﻤﻝﺍ ﺩﺭ\n46\nﺏﻠﻁ ﻰﻠﻋ ﺀﺎﻨﺒ ﺎﻬﻝ ﺯﻭﺠﻴﻭ ﺎﻬﻴﻠﻋ لﺼﺤ ﺔﻌﻔﻨﻤ ﻭﺃ لﺎﻤ ﻱﺃ ﺩﺭﺒ ﻡﻬﺘﻤﻝﺍ ﺔﻨﺍﺩﺇ ﺩﻨﻋ ﺔﻤﻜﺤﻤﻝﺍ ﺭﻤﺄﺘ ـ\nﻡﺎﻜﺤﻷ ﺎﹰﻘﻓﻭ ﻙﻝﺫﻭ ﺔﻤﻴﺭﺠﻝﺍ ﻰﻠﻋ ﺏﺘﺭﺘﻴ ﺭﺭﻀ ﻱﺃ ﻥﻋ ﺽﻴﻭﻌﺘﻝﺎﺒ ﻡﻜﺤﺘ ﻥﺃ ﻪﺌﺎﻴﻝﻭﺃ ﻭﺃ ﻪﻴﻠﻋ ﻲﻨﺠﻤﻝﺍ\n5\n. ﺔﻴﻨﺩﻤﻝﺍ ﺕﺍﺀﺍﺭﺠﻹﺍﻭ ﺔﻴﻨﺩﻤﻝﺍ ﺕﻼﻤﺎﻌﻤﻝﺍ ﻲﻨﻭﻨﺎﻗ\n\n��ا� ا � ا\nح���او ��L�� ا ��� ا��\n. ﺙﺍﺩﺤﻸﻝ ﺓﺭﺭﻘﻤﻝﺍ ﺭﻴﺒﺍﺩﺘﻝﺍ\n47\nﻥﺴ ﻲﺌﺎﻨﺠﻝﺍ لﻌﻔﻝﺍ ﺏﺎﻜﺘﺭﺍ ﺕﻗﻭ ﻎﻠﺒ ﻱﺫﻝﺍ ﻡﻬﺘﻤﻝﺍ ﺙﺩﺤﻝﺍ ﻰﻠﻋ ﺔﻴﺘﻵﺍ ﺭﻴﺒﺍﺩﺘﻝﺍ ﻕﻴﺒﻁﺘ ﺔﻤﻜﺤﻤﻠﻝ ﺯﻭﺠﻴ ـ\n: ﺓﺭﺸﻋ ﺔﻨﻤﺎﺜﻝﺍ ﻥﺴ ﻎﻠﺒﻴ ﻡﻝﻭ ﺔﻌﺒﺎﺴﻝﺍ\n، ﺔﺴﻠﺠﻝﺍ ﻲﻓ ﻪﻴﻝﻭ ﺭﻭﻀﺤﺒ ﺦﻴﺒﻭﺘﻝﺍ ( ﺃ)\nﺓﺩﻠﺠ ﻥﻴﺭﺸﻋ ﺯﻭﺎﺠﻴ ﻻ ﺎﻤﺒ ﺓﺭﺸﺎﻌﻝﺍ ﻥﺴ ﻎﻠﺒ ﻥﻤﻝ ﺏﻴﺩﺄﺘﻝﺍ لﻴﺒﺴ ﻰﻠﻋ ﺩﻠﺠﻝﺍ ( ﺏ)\n,\n. ﻪﺘﻴﺎﻋﺭ ﻥﺴﺤﺒ ﺩﻬﻌﺘﻝﺍ ﺩﻌﺒ ﻥﻤﺘﺅﻤ ﺹﺨﺸ ﻱﺃ ﻭﺃ ﻩﺩﻝﺍﻭﻝ ﺙﺩﺤﻝﺍ ﻡﻴﻠﺴﺘ ( ﺝ)\nﺩﺼﻘﺒ ﺔﻴﻋﺎﻤﺘﺠﻻﺍ ﺔﻴﺎﻋﺭﻝﺍﻭ ﺡﻼﺼﻹﺍ ﺕﺎﺴﺴﺅﻤ ﻯﺩﺤﺈﺒ ﺙﺩﺤﻝﺍ ﻕﺎﺤﻝﺇ ( ﺩ )\n. ﺕﺍﻭﻨﺴ ﺱﻤﺨ ﻰﻠﻋ ﺩﻴﺯﺘﻻﻭ ﻥﻴﺘﻨﺴ ﻥﻋ لﻘﺘﻻ ﺓﺩﻤﻝ ﻪﺒﻴﺫﻬﺘﻭ ﻪﺤﻼﺼﺇ\n. ﺥﻭﻴﺸﻠﻝ ﺓﺭﺭﻘﻤﻝﺍ ﺭﻴﺒﺍﺩﺘﻝﺍ\n48\nﺔﻴﺘﻵﺍﺭﻴﺒﺍﺩﺘﻝﺍ ﺫﺎﺨﺘﺍ ﺔﻨﺍﺩﻹﺍ ﺩﻌﺒ ﺔﻤﻜﺤﻤﻠﻝ ﺯﻭﺠﻴ , ﺹﺎﺼﻘﻝﺍ ﻡﺎﻜﺤﺍﻭ ﺔﻴﺩﺤﻝﺍ ﺕﺎﺒﻭﻘﻌﻝﺍ ﻕﻴﺒﻁﺘﺒ ﺱﺎﺴﻤ ﻥﻭﺩ ـ\n: ﺎﹰﺒﺴﺎﻨﻤ ﻙﻝﺫ ﺕﺃﺭ ﻰﺘﻤ ﻩﺭﻤﻋ ﻥﻤ ﻥﻴﻌﺒﺴﻝﺍ ﻎﻠﺒ ﻱﺫﻝﺍ ﺦﻴﺸﻝﺍ ﻥﺄﺸﺒ\n، ﻪﺘﻴﺎﻋﺭ ﻥﺴﺤﺒ ﺩﻬﻌﺘﻝﺍ ﺩﻌﺒ ﻥﻤﺘﺅﻤ ﺹﺨﺸ ﻱﺃ ﻭﺃ ﻪﻴﻝﻭﻝ ﺦﻴﺸﻝﺍ ﻡﻴﻠﺴﺘ ( ﺃ)\n، ﻪﺘﻤﻴﺭﺠﻝ ﺔﺒﻭﻘﻋ ﺓﺭﺭﻘﻤﻝﺍ ﻥﺠﺴﻝﺍ ﺓﺩﻤ ﺯﻭﺎﺠﺘ ﻻ ﺓﺩﻤ ﻪﺒﻴﺭﻐﺘ ( ﺏ)\nﻥﻴﺘﻨﺴ ﺯﻭﺎﺠﺘ ﻻ ﺓﺩﻤﻝ ﺔﻴﻋﺎﻤﺘﺠﻻﺍ ﺔﻴﺎﻋﺭﻝﺍﻭ ﺡﻼﺼﻹﺍ ﺕﺎﺴﺴﺅﻤ ﻯﺩﺤﺇ ﻪﻋﺍﺩﻴﺇ ( ﺝ)\n.\n\n. ﺔﻴﻠﻘﻋ ﺽﺍﺭﻤﺄﺒ ﻥﻴﺒﺎﺼﻤﻠﻝ ﺓﺭﺭـﻘﻤﻝﺍ ﺭﻴﺒﺍﺩﺘﻝﺍ\n49\nﻯﺩﺤﺇ ﻪﻝﺎﺨﺩﺈﺒ ﺭﻤﺄﺘ ﻥﺃ , ﻲﺴﻔﻨ ﻭﺃ ﻲﻠﻘﻋ ﺽﺭﻤ ﺏﺒﺴﺒ ﻙﺍﺭﺩﻹﺍ ﺩﻗﺎﻓ ﻡﻬﺘﻤﻝﺍ ﻥﺃ ﺎﻬﻝ ﺕﺒﺜ ﺍﺫﺇ ﺔﻤﻜﺤﻤﻠﻝ ﺯﻭﺠﻴ ـ\nﻭﺃ ﻪﻴﻝﻭ ﻲ ﻝﺇ ﻪﺘﻴﺎﻋﺭﺒ ﺩﻬﻌﺘ ﻥﺃ ﺎﻬﻝ ﺯﻭﺠﻴ ﺎﻤﻜ , ﺔﻴﺴﻔﻨﻝﺍ ﻭﺃ ﺔﻴﻠﻘﻌﻝﺍ ﺽﺍﺭﻤﻷﺍ ﺝﻼﻌﻝ ﺓﺩﻌﻤﻝﺍ ﺕﺎـﺴﺴﺅﻤﻝﺍ\n. ﻪﺘﻴﺎﻋﺭ ﻥﺴﺤﺒ ﺩﻬﻌﺘﻝﺍ ﺩﻌﺒ ﻥﻤﺘﺅﻤ ﺹﺨﺸ ﻱﺃ\n�� �� �ا ب�� �ا\n��و� �ا �� � �� �ا ��ا�� �ا\n. ﻱﺭﻭﺘﺴﺩﻝﺍ ﻡﺎﻅﻨﻝﺍ ﺽﻴﻭﻘﺘ\n50\nﺎﻬﺘﺩﺤﻭ ﻭﺃ ﺎﻬﻝﻼﻘﺘﺴﺍ ﺽﻴﺭﻌﺘ ﺩﺼﻘﺒ ﻭﺃ ﺩﻼﺒﻠﻝ ﻱﺭﻭﺘﺴﺩﻝﺍ ﻡﺎﻅﻨﻝﺍ ﺽﻴﻭﻘﺘ ﺩﺼﻘﺒ لﻌﻓ ﻱﺃ ﺏﻜﺘﺭﻴ ﻥﻤ ـ\n. ﻪﻝﺍﻭﻤﺃ ﻊﻴﻤﺠ ﺓﺭﺩﺎﺼﻤ ﺯﺍﻭﺠ ﻊﻤ لﻗﺃ ﺓﺩﻤﻝ ﻥﺠﺴﻝﺍ ﻭﺃ ﺩﺒﺅﻤﻝﺍ ﻥﺠﺴﻝﺍ ﻭﺃ ﻡﺍﺩﻋﻹﺎﺒ ﺏﻗﺎﻌﻴ ، ﺭﻁﺨﻠﻝ\n. ﺔﻝﻭﺩﻝﺍ ﺩﻀ ﺏﺭﺤﻝﺍ ﺓﺭﺎﺜﺇ\n51\nﻊﻤ لﻗﺃ ﺓﺩﻤﻝ ﻥﺠﺴﻝﺍ ﻭﺃ ﺩﺒﺅﻤﻝﺍ ﻥﺠﺴﻝﺍ ﻭﺃ ﻡﺍﺩﻋﻹﺎﺒ ﺏﻗﺎﻌﻴﻭ ﺔﻝﻭﺩﻝﺍ ﺩﻀ ﺏﺭﺤﻝﺍ ﺓﺭﺎﺜﺇ ﺔﻤﻴﺭﺠ ﺎﹰﺒﻜﺘﺭﻤ ﺩﻌﻴ ـ\n: ﻥﻤ ﻪﻝﺍﻭﻤﺃ ﻊﻴﻤﺠ ﺓﺭﺩﺎﺼﻤ ﺯﺍﻭﺠ\nﺡﻼﺴﻝﺍ ﻊﻤﺠ ﻭﺃ ﻡﻬﺒﻴﺭﺩﺘ ﻭﺃ ﺩﺍﺭﻓﻷﺍ ﻊﻤﺠﺒ ﺎﹰﻴﺭﻜﺴﻋ ﺔﻝﻭﺩﻝﺍ ﺩﻀ ﺏﺭﺤﻝﺍ ﺭﻴﺜﻴ ( ﺃ)\n، ﻪﺠﻭ ﻱﺄﺒ ﻩﺩﻴﺅﻴ ﻭﺃ ﻙﻝﺫ ﻰﻠﻋ ﻲﻨﺎﺠﻝﺍ ﺽﺭﺤﻴ ﻭﺃ ﻙﻝﺫ ﻲﻓ ﻉﺭﺸﻴ ﻭﺃ ﺩﺎﺘﻌﻝﺍ ﻭﺃ\nﻭﺃ\nﻭﺃ ﻥﺍﺩﻭﺴﻝﺍ ﻊﻤ ﺏﺭﺤ ﺔﻝﺎﺤ ﻲﻓ ﺔﻝﻭﺩ ﻱﻷ ﺔﻴﻨﺩﻤﻝﺍ ﻭﺃ ﺔﻴﺭﻜﺴﻌﻝﺍ ﺔﻤﺩﺨﻝﺎﺒ لﻤﻌﻴ ( ﺏ)\n6\nﻭﺃ , ﻯﺭﺨﺃ ﺕﻼﻤﺎﻌﻤ ﻭﺃ ﺔﻴﺭﺎﺠﺘ لﺎﻤﻋﺃ ﻱﺃ ﺎﻬﺌﻼﻜﻭ ﻊﻤ ﻭﺃ ﺎﻬﻌﻤ ﺭﺸﺎﺒﻴ\n\nﻡﻫﺯﻴﻬﺠﺘﻭ ﺩﻨﺠﻝﺍ ﻊﻤﺠﺒ ، ﺔﻝﻭﺩﻝﺍ ﻥﻤ ﻥﺫﺇ ﻥﻭﺩ ، ﻥﺍﺩﻭﺴﻝﺍ لﺨﺍﺩ ﻲﻓ ﻡﻭﻘﻴ ( ﺝ)\nﻥﺃ ﻪﻨﺄﺸ ﻥﻤ ﻥﻭﻜﻴ ﺔﻴﺒﻨﺠﺃ ﺔﻝﻭﺩ ﺩﻀ ﻲﺌﺍﺩﻋ لﻤﻌﺒ ﻡﻭﻘﻴ ﻭﺃ ﺔﻴﺒﻨﺠﺃ ﺔﻝﻭﺩ ﻭﺯﻐﻝ\nﻭﺃ , ﺏﺭﺤﻝﺍ ﺭﻁﺨﻝ ﺩﻼﺒﻝﺍ ﺽﺭﻌﻴ\nﺕﺍﺭﺌﺎﻁ ﻭﺃ ﻥﻔﺴ ﻭﺃ ﺕﺎﻤﻬﻤ ﻭﺃ ﻥﺅﻤ ﻭﺃ ﺔﺤﻠﺴﺃ ﻱﺃ لﻁﻌﻴ ﻭﺃ ﻑﻠﺘﻴ ﻭﺃ ﺏﺭﺨﻴ (ﺩ )\nﺀﺎﺒﺭﻬﻜﻝﺎﻜ ﺔﻤﺎﻌﻝﺍ ﻕﻓﺍﺭﻤﻠﻝ ﺕﺍﻭﺩﺃ ﻭﺃ ﺔﻤﺎﻋ ﻥﺎﺒﻤ ﻭﺃ لﺎﺼﺘﺍ ﻭﺃ لﻘﻨ لﺌﺎﺴﻭ ﻭﺃ\n. ﻲﺒﺭﺤﻝﺍ ﺩﻼﺒﻝﺍ ﺯﻜﺭﻤﺒ ﺭﺍﺭﻀﻷﺍ ﺩﺼﻘﺒ ﺎﻫﺭﻴﻏ ﻭﺃ ﺀﺎﻤﻝﺍ ﻭﺃ\n. ﺔﻴﺩﺎﻌﻤ ﺔﻝﻭﺩ ﻊﻤ لﻤﺎﻌﺘﻝﺍ\n52\nﺔﻴﺭﺎﺠﺘ لﺎﻤﻋﺃ ﻱﺃ ﺓﺭﺸﺎﺒﻤﺒ ﻭﺃ ﺔﻴﺩﺎﻌﻤ ﺔﻝﻭﺩ ﺎﻬﻨﺃ ﻥﺍﺩﻭﺴﻝﺍ ﻥﻠﻌﻴ ﺔﻝﻭﺩ ﻱﺃ ﺔﻤﺩﺨ ﻲﻓ لﻤﻌﻝﺎﺒ ﻥﺫﺇ ﻥﻭﺩ ﻡﻭﻘﻴ ﻥﻤ ـ\nﻭﺃ ﺔﻤﺍﺭﻐﻝﺎﺒ ﻭﺃ ﺕﺍﻭﻨﺴ ﺭﺸﻋ ﺯﻭﺎﺠﺘﻻ ﺓﺩﻤ ﻥﺠﺴﻝﺎﺒ ﺏﻗﺎﻌﻴ, ﺎﻬﺌﻼﻜﻭ ﻊﻤ ﻭﺃ ، ﺎﻬﻌﻤ ﻯﺭﺨﺃ ﺕﻼﻤﺎﻌﻤ ﻭﺃ\n. ﺎﹰﻌﻤ ﻥﻴﺘﺒﻭﻘﻌﻝﺎﺒ\n. ﺩﻼﺒﻝﺍ ﻰﻠﻋ ﺱﺴﺠﺘﻝﺍ\n53\nﺓﺭﺩﺎﺼﻤ ﺯﺍﻭﺠ ﻊﻤ لﻗﺃ ﺓﺩﻤﻝ ﻥﺠﺴﻝﺍ ﻭﺃ ﺩﺒﺅﻤﻝﺍ ﻥﺠﺴﻝﺎﺒ ﻭﺃ ﻡﺍﺩﻋﻹﺎﺒ ﺏﻗﺎﻌﻴﻭ ﺱﺴﺠﺘﻝﺍ ﺔﻤﻴﺭﺠ ﺎﹰﺒﻜﺘﺭﻤ ﺩﻌﻴ ـ\nﺎﻬﻴﻝﺇ لﻘﻨﻴ ﻭﺃ ﺎﻬﻌﻤ ﺭﺒﺎﺨﺘﻴ ﻭﺃ ﺎﻬﺌﻼﻜﻭ ﻭﺃ ﺔﻴﺒﻨﺠﺃ ﺔﻝﻭﺩﺒ لﺼﺘﻴ ﻥﺄﺒ ﺩﻼﺒﻝﺍ ﻰﻠﻋ ﺱﺴﺠﺘﻴ ﻥﻤ ﻪﻝﺍﻭﻤﺃ ﻊﻴﻤﺠ\nﻡﻝ ﺍﺫﺈﻓ , ﻲﺒﺭﺤﻝﺍ ﺩﻼﺒﻝﺍ ﺯﻜﺭﻤﺒ ﺭﺍﺭﻀﻷﺍ ﻭﺃ ﺩﻼﺒﻝﺍ ﺩﻀ ﺔﻴﺒﺭﺤﻝﺍ ﺎﻬﺘﺎﻴﻠﻤﻋ ﻲﻓ ﺎﻬﺘﻨﻭﺎﻌﻤ ﺩﺼﻘﺒ ﻙﻝﺫﻭ ﺍﹰﺭﺍﺭﺴﺃ\nﺯﻭﺎﺠﺘ ﻻ ﺓﺩﻤ ﻥﺠﺴﻝﺎﺒ ﺏﻗﺎﻌﻴ , ﹰﺎﻴﺩﺎﺼﺘﻗﺍ ﻭﺃ ﺎﹰﻴﺴﺎﻴﺴ ﺩﻼﺒﻝﺎﺒ ﺭﻀﻴ ﻥﺃ لﻤﺘﺤﻴ ﻥﻜﻝﻭ ﺩﺼﻘﻝﺍ ﻙﻝﺫﺒ ﺱﺴﺠﺘﻝﺍ ﻥﻜﻴ\n. ﺎﹰﻌﻤ ﻥﻴﺘﺒﻭﻘﻌﻝﺎﺒ ﻭﺃ ﺔﻤﺍﺭﻐﻝﺎﺒ ﻭﺃ ﺕﺍﻭﻨﺴ ﺭﺸﻋ\n. ﻡﻬﺘﺩﻋﺎﺴﻤﻭ ﺏﺭﺤﻝﺍ ﻯﺭﺴﺃ ﺏﺭﻬﺒ ﺡﺎﻤﺴﻝﺍ\n54\nﻥﻤ لﻜﻭ ﻪﺒﺭﻫ ﻥﻋ لﺎﻤﻫﺈﺒ ﻰﻀﺎﻐﺘﻴﻭﺃ ﺩﺼﻘﺒ ﺢﻤﺴﻴ ﺏﺭﺤﻝﺍ ﻱﺭﺴﺃ ﺩﺤﺃ ﺔﺴﺍﺭﺤﺒ ﻑﻠﻜﻤ ﻡﺎﻋ ﻑﻅﻭﻤ لﻜ ـ\nﺓﺩﻤ ﻥﺠﺴﻝﺎﺒ ﺏﻗﺎﻌﻴ , ﻪﻴﻠﻋ ﺽﺒﻘﻝﺍ ﻡﻭﺎﻘﻴ ﻭﺃ ﻪﻴﻭﺅﻴ ﻭﺃ ﺏﺭﻬﻝﺍ ﻰﻠﻋ ﺏﺭﺤﻝﺍ ﻯﺭـﺴﺃ ﺩﺤﺃ ﻡﻠﻋ ﻥﻋ ﺩﻋﺎﺴﻴ\n. ﺔﻤﺍﺭﻐﻝﺎﺒ ﻪﺘﺒﻗﺎﻌﻤ ﺯﻭﺠﺘ ﺎﻤﻜ ﺕﺍﻭﻨﺴ ﻊﺒﺴ ﺯﻭﺎﺠﺘ ﻻ\n\n. ﺔﻴﻤﺴﺭﻝﺍ ﺕﺍﺩﻨﺘﺴﻤﻝﺍﻭ ﺕﺎﻤﻭﻠﻌﻤﻝﺍ ﻡﻼﺘـﺴﺍﻭ ﺀﺎـﺸﻓﺇ\n55\nﻥﻭﺩ ﺔﻝﻭﺩﻝﺍ ﻥﻭﺌﺸﺒ ﻕﻠﻌﺘﺘ ﺕﺍﺩﻨﺘﺴﻤ ﻭﺃ ﺕﺎـﻤﻭﻠﻌﻤ ﻥﻤ ﺔﻴﺭـﺴ ﺭﻭﻤﺃ ﻱﺃ ﻰﻠﻋ ﺔـﻘﻴﺭﻁ ﻱﺄﺒ لـﺼﺤﻴ ﻥﻤ ـ\nﺭﺫﻋ ﻭﺃ ﻥﺫﺇ ﻥﻭﺩ ﺹﺨﺸ ﻱﻷ ﺕﺍﺩﻨﺘﺴﻤﻝﺍ ﻭﺃ ﺕﺎﻤﻭﻠﻌﻤﻝﺍ ﻙﻠﺘﺒ ﺀﺎﻀﻓﻹﺍ ﻲﻓ ﻉﺭﺸﻴ ﻭﺃ ﻲﻀﻔﻴ ﻥﻤﻭ , ﻥﺫﺇ\nﺓﺩﻤ ﻥﺠﺴﻝﺎﺒ ﺔﺒﻭﻘﻌﻝﺍ ﻥﻭﻜﺘﻭ , ﹰﺎﻌﻤ ﻥﻴﺘﺒﻭﻘﻌﻝﺎﺒ ﻭﺃ ﺔﻤﺍﺭﻐﻝﺎﺒ ﻭﺃ ﻥﻴﺘﻨﺴ ﺯﻭﺎﺠﺘﻻ ﺓﺩﻤ ﻥﺠﺴﻝﺎﺒ ﺏﻗﺎﻌﻴ , ﻉﻭﺭﺸﻤ\n. ﺎﹰﻤﺎﻋ ﺎﹰﻔﻅﻭﻤ ﻲﻨﺎﺠﻝﺍ ﻥﺎﻜ ﺍﺫﺇ ﺕﺍﻭﻨﺴ ﺱﻤﺨ ﺯﻭﺎﺠﺘ ﻻ\n. ﺔﻴﺭﻜﺴﻌﻝﺍ ﺕﺎﻤﻭﻠﻌﻤﻝﺍ ﺀﺎﺸﻓﺇ\n56\nﻭﻫﻭ ﺹﺨﺸ ﻱﺃ ﻲ ﻝﺇ ﺕﻗﻭ ﻱﺃ ﻲﻓ ﺎﻬﺒ ﻲﻀﻔﻴﻭ ﺔﻝﻭﺩﻠﻝ ﺔﻴﺭﻜﺴﻌﻝﺍ ﻥﻭﺌﺸﻝﺎﺒ ﺔﻘﻠﻌﺘﻤ 